{
    "_meta": {
        "version": "1.0.0",
        "description": "JW PowerCache 환경설정"
    },
    "defaults": {
        "mode": "observe",
        "store_driver": "file",
        "cache_public_pages": true,
        "cache_public_categories": true,
        "cache_public_board_lists": true,
        "automatic_recovery": true,
        "metrics_enabled": true,
        "debug_headers": false,
        "loading_ux_enabled": false,
        "loading_ux_scope": "all",
        "loading_ux_animation": "wave",
        "loading_ux_delay_ms": 120,
        "loading_ux_iteration_count": 5,
        "max_response_kb": 512,
        "retention_seconds": 604800,
        "lock_wait_ms": 500,
        "lock_lease_seconds": 15,
        "recovery_batch": 100
    },
    "frontend_schema": {
        "mode": { "expose": false },
        "store_driver": { "expose": false },
        "cache_public_pages": { "expose": false },
        "cache_public_categories": { "expose": false },
        "cache_public_board_lists": { "expose": false },
        "automatic_recovery": { "expose": false },
        "metrics_enabled": { "expose": false },
        "debug_headers": { "expose": false },
        "loading_ux_enabled": { "expose": true },
        "loading_ux_scope": { "expose": true },
        "loading_ux_animation": { "expose": true },
        "loading_ux_delay_ms": { "expose": true },
        "loading_ux_iteration_count": { "expose": true },
        "max_response_kb": { "expose": false },
        "retention_seconds": { "expose": false },
        "lock_wait_ms": { "expose": false },
        "lock_lease_seconds": { "expose": false },
        "recovery_batch": { "expose": false }
    }
}
